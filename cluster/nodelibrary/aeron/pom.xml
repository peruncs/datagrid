<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.datagrid</groupId>
        <artifactId>cluster-nodelibrary-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>cluster-nodelibrary-aeron</artifactId>
    <name>Eclipse Data Grid Cluster Nodelibrary Aeron Provider</name>
    <description>Aeron transport provider for the transport-neutral cluster nodelibrary</description>

    <dependencies>
        <dependency>
            <groupId>org.eclipse.datagrid</groupId>
            <artifactId>cluster-nodelibrary</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.datagrid</groupId>
            <artifactId>storage-distributed-aeron</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>io.aeron</groupId>
            <artifactId>aeron-client</artifactId>
            <version>${aeron.version}</version>
        </dependency>
        <dependency>
            <groupId>io.aeron</groupId>
            <artifactId>aeron-archive</artifactId>
            <version>${aeron.version}</version>
        </dependency>
        <dependency>
            <groupId>io.aeron</groupId>
            <artifactId>aeron-driver</artifactId>
            <version>${aeron.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.datagrid</groupId>
            <artifactId>storage-distributed-index</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Keep test fixtures on the class path; production code is JPMS-compiled,
                         while forked children intentionally receive the complete dependency class path. -->
                    <useModulePath>false</useModulePath>
                    <argLine>--add-exports java.base/jdk.internal.misc=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>crashmatrix</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.5.0</version>
                        <configuration>
                            <!-- Forked crash and Store fixtures must run on the
                                 class path; the production modules remain JPMS
                                 named at compile time. -->
                            <useModulePath>false</useModulePath>
                            <includes>
                                <include>**/ProviderCrashMatrixIT.java</include>
                                <include>**/ExternalArchiveCrashIT.java</include>
                                <include>**/AeronStoreIntegrationIT.java</include>
                            </includes>
                            <argLine>--add-exports java.base/jdk.internal.misc=ALL-UNNAMED</argLine>
                            <forkedProcessExitTimeoutInSeconds>5</forkedProcessExitTimeoutInSeconds>
                            <parallel>none</parallel>
                            <systemPropertyVariables>
                                    <crash.matrix.seed>${crash.matrix.seed}</crash.matrix.seed>
                                    <crash.matrix.random.iterations>${crash.matrix.random.iterations}</crash.matrix.random.iterations>
                                    <crash.matrix.random.seeds>${crash.matrix.random.seeds}</crash.matrix.random.seeds>
                                    <crash.budget.startup>${crash.budget.startup}</crash.budget.startup>
                                    <crash.budget.milestone>${crash.budget.milestone}</crash.budget.milestone>
                                    <crash.budget.archiveStop>${crash.budget.archiveStop}</crash.budget.archiveStop>
                                    <crash.budget.cell>${crash.budget.cell}</crash.budget.cell>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
            <properties>
                <crash.matrix.seed>1</crash.matrix.seed>
                <crash.matrix.random.iterations>3</crash.matrix.random.iterations>
                <crash.matrix.random.seeds>1</crash.matrix.random.seeds>
                <crash.budget.startup>120000</crash.budget.startup>
                <crash.budget.milestone>60000</crash.budget.milestone>
                <crash.budget.archiveStop>30000</crash.budget.archiveStop>
                <crash.budget.cell>600000</crash.budget.cell>
            </properties>
        </profile>
    </profiles>
</project>

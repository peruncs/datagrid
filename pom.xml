<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<groupId>peruncs</groupId>
	<artifactId>peruncs-cluster</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>peruncs-cluster</name>
	<description>Peruncs Data Grid Cluster Node Library with Aeron replication</description>
	<url>https://github.com/peruncs/datagrid</url>

	<organization>
		<name>MicroStream Software</name>
		<url>https://microstream.one</url>
	</organization>

	<developers>
		<developer>
			<name>MicroStream Software</name>
			<url>https://microstream.one</url>
		</developer>
	</developers>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<java.version>26</java.version>
		<maven.compiler.release>26</maven.compiler.release>
		<maven.version.minimum>3.9.0</maven.version.minimum>
		<maven.java.version.minimum>26</maven.java.version.minimum>
		<eclipse-store.version>5.0.0-SNAPSHOT</eclipse-store.version>
		<eclipse-serializer.version>5.0.0-SNAPSHOT</eclipse-serializer.version>
		<aeron.version>1.53.1</aeron.version>
		<lucene.version>9.12.3</lucene.version>
		<agrona.version>2.6.0</agrona.version>
		<jvector.version>4.0.0-rc.8</jvector.version>
	</properties>

	<!-- Eclipse Store/Serializer snapshots track upstream daily builds. The snapshot
	     metadata is re-resolved at most once per day (updatePolicy=daily, the Maven
	     default) instead of on every build (always), so two consecutive builds
	     resolve the same artifacts and stay reproducible within a day. The
	     `release` profile pins these to releases and bans snapshots via
	     requireReleaseDeps once upstream publishes them. -->
	<repositories>
		<repository>
			<id>maven-snapshots</id>
			<url>https://central.sonatype.com/repository/maven-snapshots/</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
				<updatePolicy>daily</updatePolicy>
			</snapshots>
		</repository>
	</repositories>

	<dependencyManagement>
		<dependencies>
			<!-- Converges the slf4j-api split (2.0.17 via Store/Serializer, 2.0.16 via
			     jvector): one managed version for the whole tree, enforced by the
			     dependencyConvergence rule below. -->
			<dependency>
				<groupId>org.slf4j</groupId>
				<artifactId>slf4j-api</artifactId>
				<version>2.0.17</version>
			</dependency>
			<!-- Converges the agrona split (2.6.0 via Aeron, 1.20.0 via jvector).
			     The resolved tree already runs jvector against 2.6.0 today
			     (nearest-wins); the pin only makes that choice explicit. -->
			<dependency>
				<groupId>org.agrona</groupId>
				<artifactId>agrona</artifactId>
				<version>2.6.0</version>
			</dependency>
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter-engine</artifactId>
				<version>6.1.3</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter-params</artifactId>
				<version>6.1.3</version>
				<scope>test</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.eclipse.store</groupId>
			<artifactId>storage-embedded</artifactId>
			<version>${eclipse-store.version}</version>
		</dependency>
		<!-- These are imported by the public module/API directly. Keep them
		     explicit instead of relying on upstream transitive edges. -->
		<dependency>
			<groupId>org.eclipse.store</groupId>
			<artifactId>storage</artifactId>
			<version>${eclipse-store.version}</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.store</groupId>
			<artifactId>afs-nio</artifactId>
			<version>${eclipse-store.version}</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.serializer</groupId>
			<artifactId>persistence</artifactId>
			<version>${eclipse-serializer.version}</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.serializer</groupId>
			<artifactId>persistence-binary</artifactId>
			<version>${eclipse-serializer.version}</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.serializer</groupId>
			<artifactId>afs</artifactId>
			<version>${eclipse-serializer.version}</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.serializer</groupId>
			<artifactId>base</artifactId>
			<version>${eclipse-serializer.version}</version>
		</dependency>
		<dependency>
			<groupId>org.agrona</groupId>
			<artifactId>agrona</artifactId>
			<version>${agrona.version}</version>
		</dependency>
		<dependency>
			<groupId>io.aeron</groupId>
			<artifactId>aeron-client</artifactId>
			<version>${aeron.version}</version>
		</dependency>
		<dependency>
			<groupId>io.aeron</groupId>
			<artifactId>aeron-archive</artifactId>
			<version>${aeron.version}</version>
		</dependency>
		<dependency>
			<groupId>io.aeron</groupId>
			<artifactId>aeron-driver</artifactId>
			<version>${aeron.version}</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.store</groupId>
			<artifactId>gigamap-lucene</artifactId>
			<version>${eclipse-store.version}</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.store</groupId>
			<artifactId>gigamap</artifactId>
			<version>${eclipse-store.version}</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.store</groupId>
			<artifactId>gigamap-jvector</artifactId>
			<version>${eclipse-store.version}</version>
		</dependency>
		<dependency>
			<groupId>io.github.jbellis</groupId>
			<artifactId>jvector</artifactId>
			<version>${jvector.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.lucene</groupId>
			<artifactId>lucene-core</artifactId>
			<version>${lucene.version}</version>
		</dependency>
		<!-- gigamap-lucene loads Lucene's query-parser classes at runtime when an
		     embedded index is registered, even though this project does not import
		     the parser API directly. Keep the runtime edge explicit. -->
		<dependency>
			<groupId>org.apache.lucene</groupId>
			<artifactId>lucene-queryparser</artifactId>
			<version>${lucene.version}</version>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<version>6.1.3</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-params</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- Keep test fixtures on the class path; production code is JPMS-compiled,
					     while forked children intentionally receive the complete dependency class path.
					     No suite runs on the module path (useModulePath): forked crash fixtures,
					     dynamic ScopedValue test hooks, and non-modular test helpers assume an
					     unnamed module. The JPMS descriptor is guarded instead by
					     ModuleDescriptorConsistencyTest, which parses the compiled
					     module-info.class and checks its name, requirements, and exports
					     against the source tree. -->
					<useModulePath>false</useModulePath>
					<argLine>--enable-preview --add-exports java.base/jdk.internal.misc=ALL-UNNAMED</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<version>3.6.0</version>
				<configuration>
					<!-- Keep forked integration fixtures on the class path. -->
					<useModulePath>false</useModulePath>
					<argLine>--enable-preview --add-exports java.base/jdk.internal.misc=ALL-UNNAMED</argLine>
					<excludes>
						<!-- The writer/reader soak only runs under -Psoak; it is
						     far too heavy for the default gate. -->
						<exclude>**/AeronWriterReaderSoakIT.java</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>analyze-dependencies</id>
						<phase>verify</phase>
						<goals><goal>analyze-only</goal></goals>
						<configuration>
							<failOnWarning>true</failOnWarning>
							<!-- Runtime-loaded Lucene parser classes and the JUnit engine
							     are real runtime edges that bytecode analysis cannot see. -->
							<ignoredUnusedDeclaredDependencies>
								<ignoredUnusedDeclaredDependency>org.apache.lucene:lucene-queryparser</ignoredUnusedDeclaredDependency>
								<ignoredUnusedDeclaredDependency>org.junit.jupiter:junit-jupiter-engine</ignoredUnusedDeclaredDependency>
							</ignoredUnusedDeclaredDependencies>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.14.0</version>
					<configuration>
						<release>26</release>
						<compilerArgs>
							<arg>--enable-preview</arg>
						</compilerArgs>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-dependency-plugin</artifactId>
					<version>3.11.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<version>3.4.2</version>
					<configuration>
						<archive>
							<manifestEntries>
								<built-by>${project.organization.name}</built-by>
							</manifestEntries>
						</archive>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-source-plugin</artifactId>
					<version>3.3.1</version>
					<executions>
						<execution>
							<id>attach-sources</id>
							<goals>
								<goal>jar-no-fork</goal>
							</goals>
							<configuration>
								<archive>
									<manifestEntries>
										<built-by>${project.organization.name}</built-by>
									</manifestEntries>
								</archive>
							</configuration>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-javadoc-plugin</artifactId>
					<version>3.12.0</version>
					<configuration>
						<doclint>all</doclint>
						<failOnWarnings>true</failOnWarnings>
						<!-- Maven's reactor javadoc goal puts dependency jars on the
						     class path, while their descriptors make the generated
						     offline links named-module links. JDK 26 reports that
						     mixed-mode linkage as a warning even when all source
						     documentation is valid. Each module is checked separately
						     in CI, so disable only this misleading auto-link scan. -->
						<detectOfflineLinks>false</detectOfflineLinks>
						<notree>true</notree>
						<source>26</source>
						<additionalOptions>
							<additionalOption>--enable-preview</additionalOption>
						</additionalOptions>
						<doctitle>Peruncs Data Grid API</doctitle>
						<windowtitle>Peruncs Data Grid API</windowtitle>
						<archive>
							<manifestEntries>
								<built-by>${project.organization.name}</built-by>
							</manifestEntries>
						</archive>
					</configuration>
					<executions>
						<execution>
							<id>attach-javadocs</id>
							<goals>
								<goal>jar</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-gpg-plugin</artifactId>
					<version>3.2.8</version>
					<executions>
						<execution>
							<id>sign-artifacts</id>
							<phase>verify</phase>
							<goals>
								<goal>sign</goal>
							</goals>
						</execution>
					</executions>
					<configuration>
						<!-- Prevent gpg from using pinentry programs -->
						<gpgArguments>
							<arg>--pinentry-mode</arg>
							<arg>loopback</arg>
						</gpgArguments>
						<signer>bc</signer>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-deploy-plugin</artifactId>
					<version>3.1.3</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-enforcer-plugin</artifactId>
					<version>3.6.3</version>
					<executions>
						<execution>
							<id>enforce-env</id>
							<goals>
								<goal>enforce</goal>
							</goals>
							<configuration>
								<rules>
									<requireMavenVersion>
										<version>${maven.version.minimum}</version>
									</requireMavenVersion>
									<requireJavaVersion>
										<version>${maven.java.version.minimum}</version>
									</requireJavaVersion>
								</rules>
								<fail>true</fail>
							</configuration>
						</execution>
						<execution>
							<id>enforce-convergence</id>
							<goals>
								<goal>enforce</goal>
							</goals>
							<configuration>
								<rules>
									<!-- Every dependency must resolve to one version in each
									     module. A divergence fails the build until the tree
									     is converged with dependencyManagement pins or
									     exclusions, so upgrades cannot silently mix two
									     Serializer/Store/Aeron/Lucene revisions. -->
									<dependencyConvergence/>
								</rules>
								<fail>true</fail>
							</configuration>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-clean-plugin</artifactId>
					<version>3.4.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-resources-plugin</artifactId>
					<version>3.3.1</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-install-plugin</artifactId>
					<version>3.1.3</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-site-plugin</artifactId>
					<version>4.0.0-M16</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.6.0</version>
					<configuration>
						<argLine>--enable-preview</argLine>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-failsafe-plugin</artifactId>
					<version>3.6.0</version>
					<configuration>
						<argLine>--enable-preview</argLine>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.cyclonedx</groupId>
					<artifactId>cyclonedx-maven-plugin</artifactId>
					<version>2.9.3</version>
					<executions>
						<execution>
							<phase>prepare-package</phase>
							<goals>
								<goal>makeAggregateBom</goal>
							</goals>
						</execution>
					</executions>
					<configuration>
						<projectType>library</projectType>
						<schemaVersion>1.4</schemaVersion>
						<includeBomSerialNumber>true</includeBomSerialNumber>
						<includeCompileScope>true</includeCompileScope>
						<includeProvidedScope>true</includeProvidedScope>
						<includeRuntimeScope>true</includeRuntimeScope>
						<includeSystemScope>true</includeSystemScope>
						<includeTestScope>false</includeTestScope>
						<includeLicenseText>false</includeLicenseText>
						<outputReactorProjects>true</outputReactorProjects>
						<outputFormat>all</outputFormat>
						<outputName>Eclipse-Data-Grid-Sbom</outputName>
						<outputDirectory>${project.build.directory}/sbom</outputDirectory>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<!-- The unrelocated `shade` profile was removed: shading Aeron, Store,
	     and Lucene without relocations or minimization would duplicate those
	     classes onto every consumer classpath. Reintroduce shading only with
	     full relocations plus minimizeJar behind a new profile. -->
	<profiles>
		<profile>
			<id>crashmatrix</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<version>3.6.0</version>
						<configuration>
							<!-- Forked crash and Store fixtures must run on the
							     class path; the production modules remain JPMS
							     named at compile time. -->
							<useModulePath>false</useModulePath>
							<includes>
								<include>**/ProviderCrashMatrixIT.java</include>
								<include>**/ExternalArchiveCrashIT.java</include>
								<include>**/AeronStoreIntegrationIT.java</include>
								<include>**/AeronCrashMatrixIT.java</include>
								<include>**/AeronReaderCrashMatrixIT.java</include>
							</includes>
							<argLine>--enable-preview --add-exports java.base/jdk.internal.misc=ALL-UNNAMED</argLine>
							<forkedProcessExitTimeoutInSeconds>5</forkedProcessExitTimeoutInSeconds>
							<parallel>none</parallel>
							<systemPropertyVariables>
									<crash.matrix.seed>${crash.matrix.seed}</crash.matrix.seed>
									<crash.matrix.random.iterations>${crash.matrix.random.iterations}</crash.matrix.random.iterations>
									<crash.matrix.random.seeds>${crash.matrix.random.seeds}</crash.matrix.random.seeds>
									<crash.budget.startup>${crash.budget.startup}</crash.budget.startup>
									<crash.budget.milestone>${crash.budget.milestone}</crash.budget.milestone>
									<crash.budget.archiveStop>${crash.budget.archiveStop}</crash.budget.archiveStop>
									<crash.budget.cell>${crash.budget.cell}</crash.budget.cell>
							</systemPropertyVariables>
						</configuration>
						<executions>
							<execution>
								<goals>
									<goal>integration-test</goal>
									<goal>verify</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
			<properties>
				<crash.matrix.seed>1</crash.matrix.seed>
				<crash.matrix.random.iterations>10</crash.matrix.random.iterations>
				<crash.matrix.random.seeds>1</crash.matrix.random.seeds>
				<crash.budget.startup>120000</crash.budget.startup>
				<crash.budget.milestone>60000</crash.budget.milestone>
				<crash.budget.archiveStop>30000</crash.budget.archiveStop>
				<crash.budget.cell>600000</crash.budget.cell>
			</properties>
		</profile>
		<profile>
			<id>soak</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<version>3.6.0</version>
						<configuration>
							<useModulePath>false</useModulePath>
							<includes>
								<include>**/AeronWriterReaderSoakIT.java</include>
							</includes>
							<!-- Clear the default-gate exclusion above; under this
							     profile the soak is the only integration test. -->
							<excludes combine.self="override" />
							<!-- Continuous low-overhead flight recording, dumped at fork
							     exit for offline analysis (jfr summary/print). -->
							<argLine>--enable-preview --add-exports java.base/jdk.internal.misc=ALL-UNNAMED -XX:StartFlightRecording=disk=true,dumponexit=true,filename=${project.build.directory}/soak.jfr,maxsize=250M,settings=default</argLine>
							<forkedProcessExitTimeoutInSeconds>5</forkedProcessExitTimeoutInSeconds>
							<parallel>none</parallel>
							<systemPropertyVariables>
									<soak.seconds>${soak.seconds}</soak.seconds>
									<soak.seed>${soak.seed}</soak.seed>
									<soak.writer.threads>${soak.writer.threads}</soak.writer.threads>
									<soak.query.threads>${soak.query.threads}</soak.query.threads>
									<soak.restarts>${soak.restarts}</soak.restarts>
									<soak.lagSlots>${soak.lagSlots}</soak.lagSlots>
									<soak.miniCensus>${soak.miniCensus}</soak.miniCensus>
									<soak.pollDelayMs>${soak.pollDelayMs}</soak.pollDelayMs>
									<soak.pollStallMs>${soak.pollStallMs}</soak.pollStallMs>
									<soak.fsyncDelayMs>${soak.fsyncDelayMs}</soak.fsyncDelayMs>
									<soak.corrupt>${soak.corrupt}</soak.corrupt>
									<soak.jfr.fail>${soak.jfr.fail}</soak.jfr.fail>
							</systemPropertyVariables>
						</configuration>
						<executions>
							<execution>
								<goals>
									<goal>integration-test</goal>
									<goal>verify</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
			<properties>
				<soak.seconds>30</soak.seconds>
				<soak.seed>1</soak.seed>
				<soak.writer.threads>3</soak.writer.threads>
				<soak.query.threads>2</soak.query.threads>
				<soak.restarts>10</soak.restarts>
				<soak.lagSlots>100</soak.lagSlots>
				<soak.miniCensus>20</soak.miniCensus>
				<soak.pollDelayMs>2</soak.pollDelayMs>
				<soak.pollStallMs>800</soak.pollStallMs>
				<soak.fsyncDelayMs>3</soak.fsyncDelayMs>
				<soak.corrupt>true</soak.corrupt>
				<soak.jfr.fail>false</soak.jfr.fail>
			</properties>
		</profile>
		<profile>
			<id>deploy</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
					</plugin>
				</plugins>
			</build>
		</profile>
		<!-- Release gate: resolves the Eclipse Store/Serializer daily snapshots
		     to pinned releases and fails closed on any remaining snapshot
		     dependency. Pin the versions below to the upstream releases once
		     they are published; until then this profile intentionally fails
		     dependency resolution. The default build keeps the SNAPSHOT
		     versions and works offline from the local repository. -->
		<profile>
			<id>release</id>
			<properties>
				<eclipse-store.version>5.0.0</eclipse-store.version>
				<eclipse-serializer.version>5.0.0</eclipse-serializer.version>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-enforcer-plugin</artifactId>
						<executions>
							<execution>
								<id>enforce-no-snapshots</id>
								<goals>
									<goal>enforce</goal>
								</goals>
								<configuration>
									<rules>
										<requireReleaseDeps>
											<message>No snapshots are allowed in a release build.</message>
											<!-- The project itself is versioned separately;
											     this rule guards upstream dependencies. -->
											<failWhenParentIsSnapshot>false</failWhenParentIsSnapshot>
										</requireReleaseDeps>
									</rules>
									<fail>true</fail>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>

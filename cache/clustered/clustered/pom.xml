<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.datagrid</groupId>
        <artifactId>cache-clustered-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>cache-clustered</artifactId>

    <name>Eclipse Data Grid Cache Clustered</name>
    <description>Eclipse Data Grid Cache Clustered Implementation</description>
    <url>https://projects.eclipse.org/projects/technology.datagrid</url>

    <dependencies>
        <dependency>
            <groupId>org.eclipse.store</groupId>
            <artifactId>cache-hibernate</artifactId>
            <version>${eclipse-store.version}</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>7.2.3.Final</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <!-- The published cache-hibernate module descriptor requires the
                 java.persistence module. Hibernate 7 uses jakarta.persistence, so
                 the legacy API must be present to resolve that descriptor on the
                 JPMS module path. It is provided and only used for module
                 resolution; the cache code itself uses Hibernate/Jakarta types. -->
            <groupId>javax.persistence</groupId>
            <artifactId>javax.persistence-api</artifactId>
            <version>2.2</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- Bound before the package phase so sibling modules can
                             resolve the test-jar during `mvn test` in one reactor. -->
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <!-- Only the shared fixture ships in the test-jar, and only in
                                 its own package: the other test classes live in the exported
                                 types package, which would split the package on a module path. -->
                            <includes>
                                <include>org/eclipse/datagrid/cache/clustered/test/**</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Test fixtures run on the class path; production sources stay JPMS-compiled. -->
                    <useModulePath>false</useModulePath>
                    <argLine>--add-exports java.base/jdk.internal.misc=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
